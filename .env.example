# Port the server listens on (most hosts set this for you)
PORT=3000
# Public address shown on the TV + encoded in the QR code. Optional:
# if unset, the TV uses whatever address it was opened from.
PUBLIC_URL=https://your-app.onrender.com
# Comma-separated allowed origins for sockets (optional; defaults to same-origin/any)
# CORS_ORIGIN=https://your-app.onrender.com
# Test-only: speeds up every timer (0.02 = 50x faster). Leave unset in production.
# TIME_SCALE=1
